# Python backend, Google ADK. Applies to designer, picker and room judge.
CATALOG_SITE=polyhaven
DESIGNER_PROVIDER=fake
# DESIGNER_PROVIDER=gemini
# GOOGLE_API_KEY=
# DESIGNER_MODEL=gemini-2.5-flash
# DESIGNER_PROVIDER=openai
# OPENAI_API_KEY=
# DESIGNER_MODEL=gpt-4.1
# DESIGNER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# DESIGNER_MODEL=claude-sonnet-4-6

# Optional per-role overrides (provider/model/key/base URL).
# DESIGNER_PICKER_PROVIDER=gemini
# DESIGNER_PICKER_MODEL=gemini-2.5-flash
# DESIGNER_JUDGE_PROVIDER=anthropic
# DESIGNER_JUDGE_MODEL=claude-sonnet-4-6
# OPENAI_BASE_URL=https://api.openai.com/v1

DESIGNER_PORT=8790
# Nivel de logs JSON: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
# Límite por IP y por instancia; para varias réplicas añade un perímetro distribuido.
RATE_LIMIT_PER_MINUTE=120
DESIGNER_BACKUP_COUNT=3
SEARCH_SNAPSHOT_BACKUP_COUNT=3
DESIGNER_TURN_TIMEOUT=180
# Bucle juez→agente: refina hasta que la nota media (4 métricas) alcanza el
# objetivo, sin límite de rondas ni paro por estancamiento.
# El usuario puede detenerlo desde el chat.
DESIGNER_JUDGE_TARGET=7
# DESIGNER_TOKEN=
# DESIGNER_ALLOWED_ORIGINS=https://your-editor.example
# DESIGNER_ROOM_FILE=data/designer/room-polyhaven.json
# SCREENSHOT_BUCKET=
SEARCH_URL=http://localhost:8787
# SEARCH_SYNC_TOKEN=

# hybrid is local multimodal (install [clip]); hashing requires no model download.
EMBEDDINGS_PROVIDER=hybrid
# SEARCH_CLIP_MODEL=openai/clip-vit-base-patch32
# SEARCH_HYBRID_LEX_WEIGHT=0.6
# SEARCH_CLIP_IMAGE_WEIGHT=0.25
# EMBEDDINGS_PROVIDER=jina
# JINA_API_KEY=

GENERATOR=trellis
# HF_TOKEN=
# TRIPO_API_KEY=
# SKETCHFAB_API_TOKEN=
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_API_KEY=

VITE_DESIGNER_URL=ws://localhost:8790/ws
VITE_SEARCH_URL=http://localhost:8787
