{
  "name": "desginer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "dev": "vite --port ${PORT:-5173}",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pipeline:ingest": "tsx --env-file-if-exists=.env pipeline/cli/ingest.ts",
    "pipeline:generate": "tsx --env-file-if-exists=.env pipeline/cli/generate.ts",
    "pipeline:link": "tsx --env-file-if-exists=.env pipeline/cli/link.ts",
    "pipeline:judge": "tsx --env-file-if-exists=.env pipeline/cli/judge.ts",
    "search:serve": "tsx --env-file-if-exists=.env services/search/server.ts",
    "search:sync": "tsx --env-file-if-exists=.env pipeline/cli/searchSync.ts",
    "search:eval": "tsx --env-file-if-exists=.env services/search/eval/run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@gradio/client": "^2.5.1",
    "three": "^0.185.1"
  },
  "type": "module"
}
