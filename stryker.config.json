{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/core/**/*.ts",
    "src/app/**/*.ts",
    "!src/app/importers/**",
    "!src/app/designer/DesignerClient.ts",
    "!src/core/util/id.ts"
  ],
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 85, "low": 70, "break": 75 },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["/.venv", "/data", "/public/catalog", "/dist", "/coverage", "/.pytest_cache", "/.ruff_cache"],
  "cleanTempDir": true
}
